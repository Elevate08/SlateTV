<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <package android:name="com.stasisstate.slatetv" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/immich_tv_banner"
        android:label="Immich Photos"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name=".ImmichBackgroundPluginService" android:exported="true">
            <intent-filter>
                <action android:name="com.stasisstate.slatetv.plugin.BACKGROUND_PROVIDER" />
            </intent-filter>
            <meta-data android:name="com.stasisstate.slatetv.plugin.ID" android:value="com.stasisstate.slatetv.plugin.immich" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.NAME" android:value="Immich Photos" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.DESCRIPTION" android:value="Self-hosted Immich photo library (albums, favorites, random, recent)" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.SETTINGS_ACTIVITY" android:value="com.stasisstate.slatetv.plugin.immich.ImmichSettingsActivity" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.API_VERSION" android:value="1" />
        </service>
        <activity android:name=".ImmichSettingsActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ImmichMediaProvider"
            android:authorities="com.stasisstate.slatetv.plugin.immich.media"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
