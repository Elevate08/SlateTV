<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <queries>
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="com.stasisstate.slatetv" />
        <package android:name="com.android.tv" />
        <intent>
            <action android:name="android.media.tv.TvInputService" />
        </intent>
    </queries>
    <application android:allowBackup="false" android:label="Live TV &amp; Guide"
        android:banner="@drawable/tv_banner" android:theme="@style/JellyfinTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Not a launcher activity: Slate TV Settings opens it via explicit ComponentName. -->
        <activity android:name=".JellyfinSettingsActivity" android:exported="true" />
        <activity android:name=".JellyfinGuideActivity" android:exported="true" />
        <activity android:name=".TuneChannelActivity" android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true"
            android:taskAffinity="" />
        <service android:name=".JellyfinShelfPluginService" android:exported="true">
            <intent-filter>
                <action android:name="com.stasisstate.slatetv.plugin.SHELF_PROVIDER" />
            </intent-filter>
            <meta-data android:name="com.stasisstate.slatetv.plugin.ID" android:value="com.stasisstate.slatetv.plugin.jellyfin.livetv" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.NAME" android:value="Live TV &amp; Guide" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.DESCRIPTION" android:value="Live TV channels and program guide from Android TV Live Channels or your Jellyfin server" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.SETTINGS_ACTIVITY" android:value="com.stasisstate.slatetv.plugin.jellyfin.JellyfinSettingsActivity" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.GUIDE_ACTIVITY" android:value="com.stasisstate.slatetv.plugin.jellyfin.JellyfinGuideActivity" />
            <meta-data android:name="com.stasisstate.slatetv.plugin.API_VERSION" android:value="1" />
        </service>
        <provider android:name=".JellyfinMediaProvider"
            android:authorities="com.stasisstate.slatetv.plugin.jellyfin.media"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
