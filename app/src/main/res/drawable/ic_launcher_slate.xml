<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#152232"
                android:startColor="#0A0D12"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="#E2E8F0" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
