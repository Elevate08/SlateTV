<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows local HTTP connections to self-hosted LAN Immich servers (e.g. http://192.168.1.50:2283).
    For remote access outside your LAN, always use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
